# Reference only: Go does not load this file. Set these in your shell or in Render.
# Never commit real values.

# PostgreSQL connection string (Supabase: use the Session pooler and sslmode=require)
DATABASE_URL=postgres://animehub:YOUR_URL_ENCODED_PASSWORD@localhost:5432/animehub?sslmode=disable

# Random secret, at least 32 bytes
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# Frontend origins allowed by CORS, comma-separated, no trailing slash
ALLOWED_ORIGINS=http://localhost:3000

# Render sets PORT automatically
PORT=8080

# Only for integration tests (go test ./...)
TEST_DATABASE_URL=postgres://animehub:YOUR_PASSWORD@localhost:5432/animehub_test?sslmode=disable
